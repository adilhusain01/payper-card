# PayPer Card Sui Environment
# Copy this file to .env and fill in real values. Do not commit .env.

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
PORT="3000"

# Base URL used by the CLI buyer in `npm run agent`.
API_URL="http://localhost:3000"

# Optional defaults for `npm run agent`.
DEMO_MERCHANT="Apple Inc"
DEMO_AMOUNT="5.00"

# -----------------------------------------------------------------------------
# Sui Network and Wallet
# -----------------------------------------------------------------------------
# Supported values: testnet, mainnet, devnet.
SUI_NETWORK="testnet"

# Optional. Leave blank to use the Sui SDK default fullnode for SUI_NETWORK.
SUI_RPC_URL=""

# Ed25519 Sui private key, usually exported as suiprivkey1...
# Used by the visual demo settlement path and the CLI x402 buyer.
SUI_PRIVATE_KEY=""

# Optional display/debug address for the configured Sui private key.
SUI_WALLET_ADDRESS=""

# Sui address that receives USDC x402 payments.
X402_PAY_TO_ADDRESS=""

# Optional alias supported by the server if you prefer Sui-specific naming.
SUI_PAY_TO_ADDRESS=""

# -----------------------------------------------------------------------------
# USDC on Sui
# -----------------------------------------------------------------------------
# Optional. Leave blank to use the built-in Circle native USDC coin type.
# Testnet default:
# 0xa1ec7fc00a6f40db9693ad1415d0c193ad3906494428cf252621037bd7117e29::usdc::USDC
# Mainnet default:
# 0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC
SUI_USDC_COIN_TYPE=""

# -----------------------------------------------------------------------------
# x402 Facilitator
# -----------------------------------------------------------------------------
# Supported values:
# - self: the Next.js API route dry-runs, verifies, and broadcasts the signed Sui transaction itself.
# - external: the Next.js API route calls X402_FACILITATOR_URL /verify and /settle.
# Use self unless you have a documented Sui x402 facilitator endpoint and API key.
X402_FACILITATOR_MODE="self"

# External Sui x402 facilitator URL. Only used when X402_FACILITATOR_MODE="external".
X402_FACILITATOR_URL="https://x402.blockeden.xyz"

# Optional external facilitator key. Sent as both Authorization: Bearer <key> and x-api-key.
X402_FACILITATOR_API_KEY=""

# Optional external facilitator key alias supported by the server.
BLOCKEDEN_API_KEY=""

# Payment requirement timeout in seconds.
X402_MAX_TIMEOUT_SECONDS="300"

# -----------------------------------------------------------------------------
# Lithic Sandbox
# -----------------------------------------------------------------------------
LITHIC_API_KEY=""

# -----------------------------------------------------------------------------
# Workflow / Deployment Integrations
# -----------------------------------------------------------------------------
# Used by sui-x402-workflow.json, not required for the local server.
PAYPER_CARD_URL="http://localhost:3000"
AGENT_CALLBACK_URL="http://localhost:3000/agent-callback"
SUI_WALLET_KEY_REF=""

# -----------------------------------------------------------------------------
# Legacy Compatibility
# -----------------------------------------------------------------------------
# The Sui helper can fall back to these names from the old Base/EVM template.
# Prefer SUI_PRIVATE_KEY and SUI_WALLET_ADDRESS for new deployments.
FUNDED_WALLET_PRIVATE_KEY=""
FUNDED_WALLET_ADDRESS=""
